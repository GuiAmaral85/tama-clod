{
  "name": "tama-clod",
  "version": "0.1.1",
  "description": "A pixel-art Tamagotchi that lives off your Claude Code usage.",
  "type": "module",
  "license": "MIT",
  "author": "Guilherme Amaral",
  "homepage": "https://github.com/GuiAmaral85/tama-clod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuiAmaral85/tama-clod.git"
  },
  "keywords": [
    "tamagotchi",
    "claude-code",
    "pixel-art",
    "cli",
    "react",
    "vite"
  ],
  "bin": {
    "tama-clod": "bin/tama-clod.mjs"
  },
  "files": [
    "dist",
    "web/dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"tsx watch server/server.ts\" \"vite web\"",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build web",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --target=node18 --packages=external --outfile=dist/server.mjs",
    "mac:server": "tsx server/server.ts",
    "mac:test": "swift test --package-path macos/TamaClodMenuBar",
    "mac:app": "./script/build_and_run.sh",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
