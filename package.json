{
  "name": "tama-clod",
  "version": "0.1.0",
  "description": "Tamagotchi de pixel art que vive do seu uso do Claude Code.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"tsx watch server/server.ts\" \"vite web\"",
    "build": "vite build web",
    "start": "tsx server/server.ts",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p tsconfig.json"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
